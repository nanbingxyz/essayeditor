{
    "$schema": "https://schema.tauri.app/config/2.0.0",
    "productName": "essay",
    "version": "0.1.0",
    "identifier": "ink.essay.editor",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Essay",
                "visible": false,
                "width": 800,
                "height": 800,
                "minWidth": 400,
                "minHeight": 700
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5RDI3M0Y2QUQ1MTg1MDMKUldRRGhWR3Q5blBTV1EwMi9Bb0x4blNkcDlUa294WE5IVENhYXZRdEpsYlNnR0RneURvYmVMNmYK",
            "endpoints": [
                "https://github.com/nanbingxyz/essayeditor-releases/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
